# Dependencies
node_modules/

# Build output
dist/
build/
release/
apps/windows/dist/
apps/windows/dist-electron/
apps/windows/dist-installer/
apps/windows/dist-bootstrapper/
apps/windows/dist-installer-bootstrapper/
apps/windows/node_modules/

# Le code Tauri est retiré du dépôt (tâche 7, migration Electron), mais son
# cache de compilation Rust (`target/`, ~6,4 Go) reste sur le disque jusqu'à
# un effacement à la main : il n'a jamais été suivi par git, et cette ligne
# empêche qu'un futur `git add -A` l'indexe entre-temps (c'est arrivé une
# fois pendant cette tâche : 4033 fichiers indexés par erreur, défaits avant
# commit).
apps/windows/src-tauri/

# Le vault d'essai du bac à sable (apps/windows/sandbox/neo-quiz.wsb) est
# commité avec ses deux notes ; ce que l'application y écrit pendant une
# épreuve ne l'est pas.
apps/windows/sandbox/vault/.neo-quiz/
apps/windows/sandbox/vault/Generated/
apps/windows/sandbox/vault/.trash/

# Environment & secrets
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# AI tools
.claude/
.superpowers/
# Les notes de conception (specs, plans, notes de contrôle) restent locales :
# le dépôt est public et elles portent des chemins de machine et de vaults.
docs/superpowers/

# Local temp files
temp/

# Settings runtime d'Obsidian (data.json) s'il traîne à la racine.
# NB : la sortie du build (main.js, styles.css) va dans dist/ (ignoré plus haut),
# puis est copiée dans les vaults ; la release GitHub Actions rebuilde vers release/.
/data.json

# Sessions Playwright MCP
.playwright-mcp/

# Sondes locales de diagnostic (jamais publiées)
.tmp-*

# The C/C++ language pack built by `npm run build:language-pack`: a release
# asset (28 MB), never committed.
dist-pack/

# Android app: Gradle state, build output, local SDK path, the renderer copied
# into the assets by `npm run android:web`, native libs, and signing material.
apps/android/.gradle/
apps/android/**/build/
apps/android/local.properties
apps/android/app/src/main/assets/web/
apps/android/app/src/main/assets/code/
apps/android/app/src/main/assets/code-shim.js
apps/android/app/src/main/jniLibs/
apps/android/app/src/debug/jniLibs/
*.jks
*.keystore

# The embedded Syncthing binary (fetched by `npm run fetch:syncthing`, never committed).
apps/windows/vendor/
