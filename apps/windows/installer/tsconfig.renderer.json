{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"noEmit": true,
		"forceConsistentCasingInFileNames": true,
		"types": []
	},
	"include": ["renderer.ts", "renderer-reference.ts", "protocole.ts", "noyau.ts", "presentation.ts", "../../../src/**/*.d.ts"]
}
