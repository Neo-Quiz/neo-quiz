{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM"],
		"strict": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"noEmit": true,
		"forceConsistentCasingInFileNames": true,
		"types": ["node"]
	},
	"include": ["main.ts", "main-ui.ts", "preload.ts", "worker.ts", "protocole.ts", "noyau.ts", "sondage.ts", "diagnosis.ts", "probe.ts"]
}
