# Copy to <NEOQUIZ_KEYSTORE_DIR>/keystore.properties (outside the repo).
# NEOQUIZ_KEYSTORE_DIR defaults to <home>/Keys/neo-quiz.
# The password is never stored here: scripts/with-keystore-password.ps1 decrypts
# storepass.dpapi into NEOQUIZ_KEYSTORE_PASSWORD for the Gradle process only.
storeFile=C:/path/to/neo-quiz-release.jks
keyAlias=neoquiz
