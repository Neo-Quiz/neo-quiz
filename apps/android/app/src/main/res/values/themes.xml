<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window background is the renderer's page background (nq-lueur-fond in shell.css): the
         padded content view leaves the system-bar areas showing it, so no gray band appears there. -->
    <color name="window_background">#070B14</color>
    <style name="Theme.NeoQuiz" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:colorBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
    </style>
    <!-- Native dialogs in the app's colours (FirstRunScreen's text, muted text and accent). -->
    <style name="Theme.NeoQuiz.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:colorAccent">#FF5B9DFF</item>
        <item name="android:textColorPrimary">#FFF5F7FF</item>
        <item name="android:textColorSecondary">#FFAAB6D3</item>
        <item name="android:backgroundDimAmount">0.5</item>
    </style>
</resources>
