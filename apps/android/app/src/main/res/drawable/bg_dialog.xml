<?xml version="1.0" encoding="utf-8"?>
<!-- The app's dialogs (pairing, folder picker): a dark rounded card in the app's colours
     instead of the platform's grey box (2026-10-04). -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="24dp"
    android:insetRight="24dp">
    <shape android:shape="rectangle">
        <solid android:color="#FF121826" />
        <stroke android:width="1dp" android:color="#22FFFFFF" />
        <corners android:radius="28dp" />
    </shape>
</inset>
