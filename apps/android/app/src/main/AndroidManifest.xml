<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- "All files access": the synced quiz folder lives in shared storage (Documents/Neo Quiz).
         The app is sideloaded, never published on Google Play. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- The embedded Syncthing: it runs as a foreground service (type dataSync), talks to the
         network. The Sync page scans the QR code of another device with the phone's own scanner
         or Google's: no camera permission here. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 13+: without it the foreground-service notification is hidden. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- First run: the one-tap "let Neo Quiz run in the background" dialog, so the embedded sync is not cut short. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Daily review notification: an inexact alarm (no exact-alarm permission), re-armed after boot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- The in-app updater hands a verified APK to the system installer (PackageInstaller session). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- The phone's own QR code scanner (Xiaomi / HyperOS), looked up before Google's. -->
    <queries>
        <intent>
            <action android:name="miui.intent.action.scanbarcode" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Neo Quiz"
        android:theme="@style/Theme.NeoQuiz"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true">
        <!-- Google's code scanner module, downloaded by Google Play services at install. -->
        <meta-data android:name="com.google.mlkit.vision.DEPENDENCIES" android:value="barcode_ui" />
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A pairing link: the app only validates it and fills in "Add a device" (nothing is paired
                 from a link). The https one is not verified: the chooser may appear. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="neo-quiz" android:host="pair" />
            </intent-filter>
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="neo-quiz.github.io" android:pathPrefix="/pair" />
            </intent-filter>
            <!-- A zip or a note opened or shared FROM another app (a file manager, Discord, mail...).
                 Only the file types themselves: no text/plain (every shared text would list Neo Quiz) and
                 no octet-stream on VIEW (it would list us for every unknown file). The sender's type is a
                 hint that lists us; the NAME (.zip/.md) and the content are checked in the app. Without
                 the user choosing "Always", Neo Quiz never becomes the default opener of zip files. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-markdown" />
            </intent-filter>
            <!-- The share sheet. application/octet-stream is here because WhatsApp and Discord often give
                 a .zip or .md that type; the app refuses any other name with a message. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-markdown" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- Keeps the embedded Syncthing alive in the background (not reachable by other apps). -->
        <service
            android:name=".sync.SyncService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Neo Quiz embeds Syncthing, a continuous file synchronization engine. Once the user pairs a device, it runs in the background to send and receive the user's quiz notes between the user's own devices as they change." />
        </service>

        <!-- Sync starts again with the phone and after an update, once it was switched on (a first pairing). -->
        <receiver android:name=".sync.SyncBootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The daily review alarm and its two re-arm moments. Not reachable by other apps (boot and
             package-replaced are protected system broadcasts, which an unexported receiver still gets). -->
        <receiver android:name=".notify.ReviewAlarmReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The system installer's answer to the updater's session. Not reachable by other apps. -->
        <receiver android:name=".update.UpdateResultReceiver" android:exported="false" />

        <!-- Hands a file of the quiz folder to another app (`systeme.ouvrir`); URIs are only
             minted by the bridge after the perimeter check, and granted read-only per call. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- The share sheet's own provider: not exported, read-only grants per share, and ONLY
             `cache/share/` (`share_paths.xml`), unlike the one above. -->
        <provider
            android:name=".bridge.ShareFileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>
    </application>
</manifest>
